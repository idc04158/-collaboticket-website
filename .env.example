# Google Analytics 4 — GA4 관리자 > 데이터 스트림 > 측정 ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 상담 폼 이메일 (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=CollaboTicket <onboarding@resend.dev>
CONTACT_INTERNAL_EMAIL=

# Discord 웹훅 — 채널별로 각각 생성 후 URL 붙여넣기
DISCORD_WEBHOOK_CONTACT=
DISCORD_WEBHOOK_VISITORS=

# 통합 행동 로그 저장 경로 (선택, Vercel 기본: /tmp)
# INTELLIGENCE_EVENTS_PATH=/tmp/collaboticket-intelligence-events.jsonl

# Vercel 등 서버리스 환경에서 문의 JSON 저장 경로 (선택)
# INQUIRIES_STORAGE_PATH=/tmp/collaboticket-inquiries.json

# 관리자 로그인 (CRM / 인사이트 편집 공통)
# 로컬 기본: id=admin, pw=admin1234 (NODE_ENV=production 이 아닐 때)
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=
# 또는 bcrypt 해시 사용:
# CRM_ADMIN_PASSWORD_HASH=
CRM_JWT_SECRET=
